# https://console.deepgram.com  (key needs Member permissions or higher to mint browser tokens)
DEEPGRAM_API_KEY=
# https://console.groq.com/keys
GROQ_API_KEY=

# Recommended once deployed: anyone who opens the app must enter this first.
# APP_PASSWORD=

# Optional
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_REASONING_EFFORT=low
# GROQ_SERVICE_TIER=auto
# How much recent conversation is sent to Groq each turn, in estimated tokens.
# Older messages are dropped from the request (they stay in the chat on screen).
# HISTORY_TOKEN_BUDGET=6000
